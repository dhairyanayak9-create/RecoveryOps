<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root"
        android:orientation="vertical"
        android:background="#F3F3F7"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/loginPanel"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="26dp"
            android:background="#332F4A"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Space android:layout_width="1dp" android:layout_height="48dp"/>
            <TextView
                android:text="R"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="42sp"
                android:background="#67558F"
                android:layout_width="78dp"
                android:layout_height="78dp"/>
            <TextView
                android:text="RecoveryOps"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="28sp"
                android:layout_marginTop="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="Recover  •  Verify  •  Secure"
                android:textColor="#D7D2E4"
                android:textSize="13sp"
                android:layout_marginBottom="38dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <EditText
                android:id="@+id/username"
                android:hint="Username / Email / Mobile"
                android:autofillHints=""
                android:inputType="text"
                android:importantForAutofill="no"
                android:textColor="#FFFFFF"
                android:textColorHint="#B9B4C8"
                android:singleLine="true"
                android:padding="15dp"
                android:backgroundTint="#8E80B5"
                android:layout_width="match_parent"
                android:layout_height="56dp"/>
            <EditText
                android:id="@+id/password"
                android:hint="Password"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#B9B4C8"
                android:singleLine="true"
                android:padding="15dp"
                android:backgroundTint="#8E80B5"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"/>
            <Button
                android:id="@+id/login"
                android:text="LOGIN"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#67558F"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="58dp"/>
            <TextView
                android:id="@+id/result"
                android:textColor="#FFB4AB"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/appPanel"
            android:visibility="gone"
            android:orientation="vertical"
            android:background="#F3F3F7"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="#332F4A"
                android:layout_width="match_parent"
                android:layout_height="76dp">
                <ImageButton
                    android:id="@+id/menuBtn"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:background="@android:color/transparent"
                    android:tint="#FFFFFF"
                    android:contentDescription="Menu"
                    android:padding="8dp"
                    android:layout_width="52dp"
                    android:layout_height="56dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                    <TextView
                        android:id="@+id/pageTitle"
                        android:text="Home"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="23sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/welcome"
                        android:textColor="#D7D2E4"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:fillViewport="true"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/dashboardPage"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:text="R"
                                android:gravity="center"
                                android:textColor="#F6D65A"
                                android:textStyle="bold"
                                android:textSize="31sp"
                                android:background="@drawable/logo_circle"
                                android:layout_width="118dp"
                                android:layout_height="118dp"/>
                            <TextView
                                android:text="RecoveryOps"
                                android:textColor="#332F4A"
                                android:textStyle="bold"
                                android:textSize="22sp"
                                android:layout_marginTop="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:text="Operations Dashboard"
                                android:textColor="#77758A"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="16dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="60dp">
                            <TextView
                                android:text="⌄"
                                android:gravity="center"
                                android:textColor="#332F4A"
                                android:textSize="27sp"
                                android:background="@drawable/search_box"
                                android:layout_width="52dp"
                                android:layout_height="60dp"/>
                            <EditText
                                android:id="@+id/dashboardSearch"
                                android:hint="Last 4 digits of Car No."
                                android:inputType="number"
                                android:maxLength="4"
                                android:singleLine="true"
                                android:textColor="#332F4A"
                                android:textColorHint="#77758A"
                                android:textSize="15sp"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:paddingEnd="12dp"
                                android:background="@drawable/search_box"
                                android:selectAllOnFocus="true"
                                android:layout_marginStart="7dp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="60dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_marginTop="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="68dp"
                            android:background="@drawable/dashboard_card">
                            <TextView
                                android:text="Last Downloaded DB File:"
                                android:textColor="#6F6C7E"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:id="@+id/lastSyncText"
                                android:text="Not synced yet"
                                android:textColor="#332F4A"
                                android:textSize="13sp"
                                android:layout_marginStart="6dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="126dp">
                            <LinearLayout
                                android:orientation="vertical"
                                android:gravity="center_vertical"
                                android:padding="16dp"
                                android:background="@drawable/dashboard_card"
                                android:layout_marginEnd="5dp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent">
                                <TextView android:text="TOTAL RECORDS" android:textColor="#77758A" android:textStyle="bold" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:id="@+id/totalStat" android:text="0" android:textColor="#332F4A" android:textStyle="bold" android:textSize="26sp" android:layout_marginTop="7dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:gravity="center_vertical"
                                android:padding="16dp"
                                android:background="@drawable/dashboard_card"
                                android:layout_marginStart="5dp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent">
                                <TextView android:text="LOCAL RECORDS" android:textColor="#77758A" android:textStyle="bold" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:id="@+id/stats" android:text="0 records" android:textColor="#332F4A" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="7dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:text="SYNC STATUS"
                            android:textColor="#332F4A"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:layout_marginTop="18dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:id="@+id/syncStatus"
                            android:text="Ready"
                            android:textColor="#77758A"
                            android:textSize="14sp"
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:id="@+id/activityText"
                            android:text="Server connection will appear here."
                            android:textColor="#77758A"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/searchPage"
                        android:visibility="gone"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView android:text="SEARCH RESULTS" android:textColor="#77758A" android:textSize="11sp" android:letterSpacing="0.12" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Registration Search" android:textColor="#332F4A" android:textStyle="bold" android:textSize="28sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <EditText android:id="@+id/search" android:hint="Enter last 4 digits" android:inputType="number" android:maxLength="4" android:singleLine="true" android:textColor="#332F4A" android:textSize="18sp" android:padding="14dp" android:background="@drawable/search_box" android:selectAllOnFocus="true" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="60dp"/>
                        <Button android:id="@+id/voiceBtn" android:text="VOICE SEARCH" android:textStyle="bold" android:textSize="15sp" android:textColor="#FFFFFF" android:backgroundTint="#67558F" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="58dp"/>
                        <TextView android:id="@+id/resultMain" android:text="Enter last 4 digits" android:textColor="#332F4A" android:textStyle="bold" android:textSize="17sp" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/resultCount" android:text="0" android:textColor="#77758A" android:textSize="13sp" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <GridLayout android:id="@+id/resultList" android:columnCount="2" android:useDefaultMargins="false" android:alignmentMode="alignMargins" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/modulePage"
                        android:visibility="gone"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView android:id="@+id/moduleMessage" android:textColor="#332F4A" android:textSize="19sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </FrameLayout>
            </ScrollView>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#FFFFFF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_width="match_parent"
                android:layout_height="76dp">
                <Button android:id="@+id/bottomHome" android:text="HOME" android:textSize="12sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#315FAE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="62dp"/>
                <Button android:id="@+id/modeBtn" android:text="ONLINE" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#159447" android:layout_width="0dp" android:layout_weight="1" android:layout_height="62dp"/>
                <Button android:id="@+id/sync" android:text="SYNC" android:textSize="12sp" android:textStyle="bold" android:textColor="#332F4A" android:backgroundTint="#F6D65A" android:layout_width="0dp" android:layout_weight="1" android:layout_height="62dp"/>
                <Button android:id="@+id/bottomProfile" android:text="PROFILE" android:textSize="12sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#6F6C7E" android:layout_width="0dp" android:layout_weight="1" android:layout_height="62dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navDrawer"
        android:orientation="vertical"
        android:background="#332F4A"
        android:padding="20dp"
        android:layout_gravity="start"
        android:layout_width="300dp"
        android:layout_height="match_parent">
        <TextView android:text="RecoveryOps" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="25sp" android:layout_marginTop="30dp" android:layout_marginBottom="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/drawerRole" android:text="OPERATIONS" android:textColor="#D7D2E4" android:textSize="11sp" android:layout_marginBottom="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/navDashboard" android:text="Dashboard" android:textColor="#FFFFFF" android:backgroundTint="#4B456A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="52dp"/>
        <Button android:id="@+id/navSearch" android:text="Data Search" android:textColor="#FFFFFF" android:backgroundTint="#332F4A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="52dp"/>
        <Button android:id="@+id/navTwo" android:text="Two Wheeler Files" android:textColor="#FFFFFF" android:backgroundTint="#332F4A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="50dp"/>
        <Button android:id="@+id/navFour" android:text="Four Wheeler Files" android:textColor="#FFFFFF" android:backgroundTint="#332F4A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="50dp"/>
        <Button android:id="@+id/navCv" android:text="CV Files" android:textColor="#FFFFFF" android:backgroundTint="#332F4A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="50dp"/>
        <Button android:id="@+id/navFiles" android:text="File Management" android:textColor="#FFFFFF" android:backgroundTint="#332F4A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="50dp"/>
        <Button android:id="@+id/navBanks" android:text="Bank Management" android:textColor="#FFFFFF" android:backgroundTint="#332F4A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="50dp"/>
        <Button android:id="@+id/navClients" android:text="Clients" android:textColor="#FFFFFF" android:backgroundTint="#332F4A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="50dp"/>
        <Button android:id="@+id/navUsers" android:text="Users" android:textColor="#FFFFFF" android:backgroundTint="#332F4A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="50dp"/>
        <Button android:id="@+id/navReports" android:text="Reports" android:textColor="#FFFFFF" android:backgroundTint="#332F4A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="50dp"/>
        <Button android:id="@+id/navNotifications" android:text="Notifications" android:textColor="#FFFFFF" android:backgroundTint="#332F4A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="50dp"/>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
        <Button android:id="@+id/logoutBtn" android:text="LOGOUT" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:backgroundTint="#B4233F" android:layout_width="match_parent" android:layout_height="56dp"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
