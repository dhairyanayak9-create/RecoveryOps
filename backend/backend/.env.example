# Supabase PostgreSQL (recommended production setup)
# Copy the connection string from Supabase -> Project Settings -> Database.
# Use the direct connection or Session Pooler connection string.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# DATABASE_URL remains supported for Railway/other deployments.
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
CORS_ORIGINS=*
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
OTP_DEV_MODE=false
