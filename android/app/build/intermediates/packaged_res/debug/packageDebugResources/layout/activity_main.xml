<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer" android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:id="@+id/root" android:orientation="vertical" android:background="#F4F7FC"
        android:layout_width="match_parent" android:layout_height="match_parent">

        <LinearLayout android:id="@+id/loginPanel" android:orientation="vertical" android:gravity="center_horizontal"
            android:padding="26dp" android:background="#061B3A" android:layout_width="match_parent" android:layout_height="match_parent">
            <Space android:layout_width="1dp" android:layout_height="55dp"/>
            <TextView android:text="R" android:gravity="center" android:textColor="#FFFFFF" android:textStyle="bold"
                android:textSize="42sp" android:background="#1257D6" android:layout_width="78dp" android:layout_height="78dp"/>
            <TextView android:text="RecoveryOps" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="28sp"
                android:layout_marginTop="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Recover  •  Verify  •  Secure" android:textColor="#BFD2F4" android:textSize="13sp"
                android:layout_marginBottom="38dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/username" android:hint="Username / Email / Mobile" android:textColor="#FFFFFF"
                android:textColorHint="#9FB0CA" android:singleLine="true" android:padding="15dp" android:backgroundTint="#3C73D9"
                android:layout_width="match_parent" android:layout_height="56dp"/>
            <EditText android:id="@+id/password" android:hint="Password" android:textColor="#FFFFFF" android:textColorHint="#9FB0CA"
                android:inputType="textPassword" android:singleLine="true" android:padding="15dp" android:backgroundTint="#3C73D9"
                android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="56dp"/>
            <Button android:id="@+id/login" android:text="LOGIN" android:textStyle="bold" android:textColor="#FFFFFF"
                android:backgroundTint="#1257D6" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="54dp"/>
            <TextView android:id="@+id/result" android:textColor="#FFB4AB" android:textSize="14sp" android:layout_marginTop="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/appPanel" android:visibility="gone" android:orientation="vertical" android:background="#F4F7FC"
            android:layout_width="match_parent" android:layout_height="match_parent">

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="#061B3A"
                android:layout_width="match_parent" android:layout_height="76dp">
                <ImageButton android:id="@+id/menuBtn" android:src="@android:drawable/ic_menu_sort_by_size" android:background="@android:color/transparent"
                    android:tint="#FFFFFF" android:contentDescription="Menu" android:layout_width="42dp" android:layout_height="48dp"/>
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="0.65" android:layout_height="wrap_content">
                    <TextView android:id="@+id/pageTitle" android:text="Home" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/welcome" android:textColor="#BFD2F4" android:textSize="10sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <EditText android:id="@+id/dashboardSearch" android:hint="Search last 4 digits" android:inputType="number" android:maxLength="4"
                    android:singleLine="true" android:textColor="#10203A" android:textColorHint="#64748B" android:textSize="15sp"
                    android:gravity="center" android:padding="8dp" android:backgroundTint="#FFFFFF" android:selectAllOnFocus="true"
                    android:layout_width="0dp" android:layout_weight="1.45" android:layout_height="48dp"/>
            </LinearLayout>

            <ScrollView android:fillViewport="true" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">

                    <LinearLayout android:id="@+id/dashboardPage" android:orientation="vertical" android:padding="16dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="RECOVERY OPERATIONS" android:textColor="#64748B" android:textSize="11sp" android:letterSpacing="0.12"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Dashboard" android:textColor="#10203A" android:textStyle="bold" android:textSize="29sp"
                            android:layout_marginTop="3dp" android:layout_marginBottom="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <LinearLayout android:orientation="vertical" android:padding="15dp" android:background="#FFFFFF" android:layout_marginEnd="6dp"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="100dp">
                                <TextView android:text="TOTAL RECORDS" android:textColor="#64748B" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:id="@+id/totalStat" android:text="0" android:textColor="#10203A" android:textStyle="bold" android:textSize="27sp"
                                    android:layout_marginTop="9dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout android:orientation="vertical" android:padding="15dp" android:background="#FFFFFF" android:layout_marginStart="6dp"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="100dp">
                                <TextView android:text="LOCAL RECORDS" android:textColor="#64748B" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:id="@+id/stats" android:text="0 records" android:textColor="#10203A" android:textStyle="bold" android:textSize="20sp"
                                    android:layout_marginTop="11dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:text="Recent Activity" android:textColor="#10203A" android:textStyle="bold" android:textSize="18sp"
                            android:layout_marginTop="18dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/activityText" android:text="Server connection will appear here." android:textColor="#64748B" android:textSize="13sp"
                            android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/syncStatus" android:text="Sync assigned records for offline use." android:textColor="#64748B" android:textSize="13sp"
                            android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/searchPage" android:visibility="gone" android:orientation="vertical" android:padding="16dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="SEARCH RESULTS" android:textColor="#64748B" android:textSize="11sp" android:letterSpacing="0.12"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Registration Search" android:textColor="#10203A" android:textStyle="bold" android:textSize="27sp"
                            android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <EditText android:id="@+id/search" android:hint="Enter last 4 digits" android:inputType="number" android:maxLength="4" android:singleLine="true"
                            android:textColor="#10203A" android:textSize="18sp" android:padding="12dp" android:backgroundTint="#1257D6"
                            android:selectAllOnFocus="true" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="52dp"/>
                        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <Button android:id="@+id/voiceBtn" android:text="VOICE" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#1257D6"
                                android:layout_marginTop="8dp" android:layout_marginEnd="5dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp"/>
                        </LinearLayout>
                        <TextView android:id="@+id/resultMain" android:text="Enter last 4 digits" android:textColor="#10203A" android:textStyle="bold" android:textSize="16sp"
                            android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/resultCount" android:text="0" android:textColor="#64748B" android:textSize="12sp"
                            android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <GridLayout android:id="@+id/resultList" android:columnCount="2" android:useDefaultMargins="false" android:alignmentMode="alignMargins"
                            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/modulePage" android:visibility="gone" android:orientation="vertical" android:padding="16dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:id="@+id/moduleMessage" android:textColor="#10203A" android:textSize="19sp" android:textStyle="bold"
                            android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </FrameLayout>
            </ScrollView>

            <LinearLayout android:orientation="horizontal" android:gravity="center" android:background="#FFFFFF" android:paddingTop="4dp" android:paddingBottom="4dp"
                android:layout_width="match_parent" android:layout_height="62dp">
                <Button android:id="@+id/bottomHome" android:text="HOME" android:textSize="9sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1257D6"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"/>
                <Button android:id="@+id/modeBtn" android:text="ONLINE" android:textSize="9sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#159447"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"/>
                <Button android:id="@+id/sync" android:text="SYNC" android:textSize="9sp" android:textStyle="bold" android:textColor="#10203A" android:backgroundTint="#F6D65A"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"/>
                <Button android:id="@+id/bottomProfile" android:text="PROFILE" android:textSize="9sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#64748B"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/navDrawer" android:orientation="vertical" android:background="#061B3A" android:padding="20dp" android:layout_gravity="start"
        android:layout_width="300dp" android:layout_height="match_parent">
        <TextView android:text="RecoveryOps" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="25sp" android:layout_marginTop="30dp" android:layout_marginBottom="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/drawerRole" android:text="OPERATIONS" android:textColor="#9FB0CA" android:textSize="11sp" android:layout_marginBottom="20dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/navDashboard" android:text="Dashboard" android:textColor="#FFFFFF" android:backgroundTint="#17427A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="48dp"/>
        <Button android:id="@+id/navSearch" android:text="Data Search" android:textColor="#FFFFFF" android:backgroundTint="#061B3A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="48dp"/>
        <Button android:id="@+id/navTwo" android:text="Two Wheeler Files" android:textColor="#FFFFFF" android:backgroundTint="#061B3A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="46dp"/>
        <Button android:id="@+id/navFour" android:text="Four Wheeler Files" android:textColor="#FFFFFF" android:backgroundTint="#061B3A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="46dp"/>
        <Button android:id="@+id/navCv" android:text="CV Files" android:textColor="#FFFFFF" android:backgroundTint="#061B3A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="46dp"/>
        <Button android:id="@+id/navFiles" android:text="File Management" android:textColor="#FFFFFF" android:backgroundTint="#061B3A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="46dp"/>
        <Button android:id="@+id/navBanks" android:text="Bank Management" android:textColor="#FFFFFF" android:backgroundTint="#061B3A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="46dp"/>
        <Button android:id="@+id/navClients" android:text="Clients" android:textColor="#FFFFFF" android:backgroundTint="#061B3A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="46dp"/>
        <Button android:id="@+id/navUsers" android:text="Users" android:textColor="#FFFFFF" android:backgroundTint="#061B3A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="46dp"/>
        <Button android:id="@+id/navReports" android:text="Reports" android:textColor="#FFFFFF" android:backgroundTint="#061B3A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="46dp"/>
        <Button android:id="@+id/navNotifications" android:text="Notifications" android:textColor="#FFFFFF" android:backgroundTint="#061B3A" android:gravity="start|center_vertical" android:layout_width="match_parent" android:layout_height="46dp"/>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
        <Button android:id="@+id/logoutBtn" android:text="LOGOUT" android:textColor="#FFFFFF" android:backgroundTint="#B4233F" android:layout_width="match_parent" android:layout_height="50dp"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
